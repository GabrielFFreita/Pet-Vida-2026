# Copie este arquivo para .env e preencha os dados do banco MySQL remoto.
# Nunca publique o arquivo .env nem credenciais reais.

# Porta HTTP publicada pela aplicação PHP/Apache.
APP_PORT=8080

# Servidor MySQL remoto já existente.
DB_HOST=mysql.exemplo.com
DB_PORT=3306
DB_NAME=petvida_db
DB_USER=usuario_do_banco
DB_PASSWORD=preencha_a_senha_real_aqui

# Use 1 somente para diagnóstico local temporário; mantenha 0 normalmente.
APP_DEBUG=0
